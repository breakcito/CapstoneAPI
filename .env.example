APP_NAME="CapstoneAPI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:9095
SERVER_PORT=9095

# Localización Perú
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

# Logs detallados para desarrollo
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de Datos - Localhost en el VPS
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Drivers
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Autenticación API
JWT_SECRET=

BROADCAST_CONNECTION=null
# Modulo IA - Chat de analytics (solo lectura)
IA_API_KEY=
IA_BASE_URL=https://api.minimax.io/v1
IA_MODEL=MiniMax-M3
IA_ROL_ADMIN=2
IA_MAX_MENSAJES=40
IA_MAX_FILAS=500
IA_MAX_ITERACIONES=8
IA_SCHEMA_TTL=3600
IA_MAX_ADJUNTOS=5
IA_MAX_ADJUNTOS_MB=10
